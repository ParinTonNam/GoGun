generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ─── Enum Types ───────────────────────────────────────────────────────────────

enum DateStatus {
  proposed
  confirmed

  @@map("date_status_enum")
}

enum TripMemberRole {
  organizer
  member

  @@map("trip_member_role_enum")
}

enum TripMemberStatus {
  invited
  joined
  declined

  @@map("trip_member_status_enum")
}

enum TransferStatus {
  pending
  slip_attached
  confirmed

  @@map("transfer_status_enum")
}

enum AvailabilityStatus {
  available
  uncertain
  unavailable

  @@map("availability_status_enum")
}

enum PollStatus {
  open
  closed

  @@map("poll_status_enum")
}

enum PackingCategory {
  shared
  personal

  @@map("packing_category_enum")
}

// ─── Models ───────────────────────────────────────────────────────────────────

model User {
  id            String   @id @default(uuid()) @db.Uuid
  username      String   @unique
  email         String   @unique
  password_hash String
  display_name  String
  avatar_color  String   @default("#c0613e")
  phone         String?
  is_guest      Boolean  @default(false)
  created_at    DateTime @default(now()) @db.Timestamptz(6)

  organized_trips    Trip[]               @relation("TripOrganizer")
  trip_memberships   TripMember[]
  paid_expenses      Expense[]            @relation("ExpensePayer")
  expense_splits     ExpenseSplit[]
  transfers_sent     TransferSlip[]       @relation("TransferSender")
  transfers_received TransferSlip[]       @relation("TransferReceiver")
  availability       Availability[]
  polls_created      Poll[]               @relation("PollCreator")
  poll_votes         PollVote[]
  packing_assignees  PackingItemAssignee[]
  packing_checks     PackingItemCheck[]
  checklist_checks   ChecklistItemCheck[]

  @@map("users")
}

model Trip {
  id                           String     @id @default(uuid()) @db.Uuid
  name                         String
  destination                  String
  duration_days                Int
  proposed_start_date          DateTime?  @db.Date
  confirmed_start_date         DateTime?  @db.Date
  date_status                  DateStatus @default(proposed)
  currency                     String
  invite_code                  String     @unique
  organizer_id                 String     @db.Uuid
  budget_per_person            Decimal?   @db.Decimal(12, 2)
  allow_member_expenses        Boolean    @default(true)
  allow_member_itinerary_edit  Boolean    @default(true)
  allow_member_invite          Boolean    @default(false)
  created_at                   DateTime   @default(now()) @db.Timestamptz(6)

  organizer       User            @relation("TripOrganizer", fields: [organizer_id], references: [id])
  members         TripMember[]
  itinerary_days  ItineraryDay[]
  expenses        Expense[]
  transfer_slips  TransferSlip[]
  availability    Availability[]
  polls           Poll[]
  packing_items   PackingItem[]
  checklist_items ChecklistItem[]
  wheel_options   WheelOption[]

  @@map("trips")
}

model TripMember {
  id        String           @id @default(uuid()) @db.Uuid
  trip_id   String           @db.Uuid
  user_id   String           @db.Uuid
  role      TripMemberRole   @default(member)
  status    TripMemberStatus @default(joined)
  joined_at DateTime?        @db.Timestamptz(6)

  trip Trip @relation(fields: [trip_id], references: [id], onDelete: Cascade)
  user User @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@unique([trip_id, user_id])
  @@map("trip_members")
}

model ItineraryDay {
  id         String   @id @default(uuid()) @db.Uuid
  trip_id    String   @db.Uuid
  day_number Int
  date       DateTime @db.Date
  label      String

  trip       Trip                @relation(fields: [trip_id], references: [id], onDelete: Cascade)
  activities ItineraryActivity[]

  @@unique([trip_id, day_number])
  @@map("itinerary_days")
}

model ItineraryActivity {
  id         String @id @default(uuid()) @db.Uuid
  day_id     String @db.Uuid
  time       String
  title      String
  sort_order Int    @default(0)

  day ItineraryDay @relation(fields: [day_id], references: [id], onDelete: Cascade)

  @@map("itinerary_activities")
}

model Expense {
  id              String   @id @default(uuid()) @db.Uuid
  trip_id         String   @db.Uuid
  name            String
  category        String
  total_amount    Decimal  @db.Decimal(12, 2)
  currency        String
  paid_by_user_id String   @db.Uuid
  created_at      DateTime @default(now()) @db.Timestamptz(6)

  trip    Trip           @relation(fields: [trip_id], references: [id], onDelete: Cascade)
  paid_by User           @relation("ExpensePayer", fields: [paid_by_user_id], references: [id])
  splits  ExpenseSplit[]

  @@map("expenses")
}

model ExpenseSplit {
  id         String  @id @default(uuid()) @db.Uuid
  expense_id String  @db.Uuid
  user_id    String  @db.Uuid
  amount     Decimal @db.Decimal(12, 2)

  expense Expense @relation(fields: [expense_id], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [user_id], references: [id])

  @@unique([expense_id, user_id])
  @@map("expense_splits")
}

model TransferSlip {
  id           String         @id @default(uuid()) @db.Uuid
  trip_id      String         @db.Uuid
  from_user_id String         @db.Uuid
  to_user_id   String         @db.Uuid
  amount       Decimal        @db.Decimal(12, 2)
  currency     String
  status       TransferStatus @default(pending)
  slip_url     String?
  confirmed_at DateTime?      @db.Timestamptz(6)
  created_at   DateTime       @default(now()) @db.Timestamptz(6)

  trip      Trip @relation(fields: [trip_id], references: [id], onDelete: Cascade)
  from_user User @relation("TransferSender", fields: [from_user_id], references: [id])
  to_user   User @relation("TransferReceiver", fields: [to_user_id], references: [id])

  @@map("transfer_slips")
}

model Availability {
  id      String             @id @default(uuid()) @db.Uuid
  trip_id String             @db.Uuid
  user_id String             @db.Uuid
  date    DateTime           @db.Date
  status  AvailabilityStatus

  trip Trip @relation(fields: [trip_id], references: [id], onDelete: Cascade)
  user User @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@unique([trip_id, user_id, date])
  @@map("availability")
}

model Poll {
  id                 String     @id @default(uuid()) @db.Uuid
  trip_id            String     @db.Uuid
  title              String
  subtitle           String?
  close_date         DateTime?  @db.Timestamptz(6)
  status             PollStatus @default(open)
  created_by_user_id String?    @db.Uuid
  created_at         DateTime   @default(now()) @db.Timestamptz(6)

  trip       Trip         @relation(fields: [trip_id], references: [id], onDelete: Cascade)
  created_by User?        @relation("PollCreator", fields: [created_by_user_id], references: [id])
  options    PollOption[]
  votes      PollVote[]

  @@map("polls")
}

model PollOption {
  id         String @id @default(uuid()) @db.Uuid
  poll_id    String @db.Uuid
  text       String
  sort_order Int    @default(0)

  poll  Poll       @relation(fields: [poll_id], references: [id], onDelete: Cascade)
  votes PollVote[]

  @@map("poll_options")
}

model PollVote {
  id        String   @id @default(uuid()) @db.Uuid
  poll_id   String   @db.Uuid
  option_id String   @db.Uuid
  user_id   String   @db.Uuid
  voted_at  DateTime @default(now()) @db.Timestamptz(6)

  poll   Poll       @relation(fields: [poll_id], references: [id], onDelete: Cascade)
  option PollOption @relation(fields: [option_id], references: [id], onDelete: Cascade)
  user   User       @relation(fields: [user_id], references: [id])

  @@unique([poll_id, user_id])
  @@map("poll_votes")
}

model ChecklistItem {
  id         String @id @default(uuid()) @db.Uuid
  trip_id    String @db.Uuid
  text       String
  sort_order Int    @default(0)

  trip   Trip                 @relation(fields: [trip_id], references: [id], onDelete: Cascade)
  checks ChecklistItemCheck[]

  @@map("checklist_items")
}

model ChecklistItemCheck {
  item_id    String   @db.Uuid
  user_id    String   @db.Uuid
  checked_at DateTime @default(now()) @db.Timestamptz(6)

  item ChecklistItem @relation(fields: [item_id], references: [id], onDelete: Cascade)
  user User          @relation(fields: [user_id], references: [id])

  @@id([item_id, user_id])
  @@map("checklist_checks")
}

model PackingItem {
  id         String          @id @default(uuid()) @db.Uuid
  trip_id    String          @db.Uuid
  text       String
  category   PackingCategory @default(shared)
  sort_order Int             @default(0)

  trip      Trip                  @relation(fields: [trip_id], references: [id], onDelete: Cascade)
  assignees PackingItemAssignee[]
  checks    PackingItemCheck[]

  @@map("packing_items")
}

model PackingItemAssignee {
  item_id String @db.Uuid
  user_id String @db.Uuid

  item PackingItem @relation(fields: [item_id], references: [id], onDelete: Cascade)
  user User        @relation(fields: [user_id], references: [id])

  @@id([item_id, user_id])
  @@map("packing_assignees")
}

model PackingItemCheck {
  item_id    String   @db.Uuid
  user_id    String   @db.Uuid
  checked_at DateTime @default(now()) @db.Timestamptz(6)

  item PackingItem @relation(fields: [item_id], references: [id], onDelete: Cascade)
  user User        @relation(fields: [user_id], references: [id])

  @@id([item_id, user_id])
  @@map("packing_checks")
}

model WheelOption {
  id         String @id @default(uuid()) @db.Uuid
  trip_id    String @db.Uuid
  text       String
  color      String
  sort_order Int    @default(0)

  trip Trip @relation(fields: [trip_id], references: [id], onDelete: Cascade)

  @@map("wheel_options")
}
